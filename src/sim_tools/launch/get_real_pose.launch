<?xml version="1.0"?>
<launch>
    <!-- 无人机型号及数量-->
    <arg name="vehicle_type" default="iris"/>
    <arg name="vehicle_num" default="1"/>

    <node pkg="sim_tools" name="get_real_pose_node" type="get_local_pose.py" output="screen">
        <param name="vehicle_type" value="$(arg vehicle_type)"/>
        <param name="vehicle_num" value="$(arg vehicle_num)"/>
        <remap from="iris_0/sim_tool/odometry" to="/vins_fusion/imu_propagate" />
        
    </node>
    



</launch>