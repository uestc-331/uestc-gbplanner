<launch>
  <arg name="robot_name" default="rmf_obelix"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz_en" default="false"/>
  <arg name="launch_prefix" default=""/>
  <arg name="traj_server_en" default="true"/>

  <arg name="odometry_topic" default="/vins_fusion/imu_propagate"/>
  <arg name="planner_odometry_topic" default="$(arg robot_name)/ground_truth/odometry_throttled"/>
  <arg name="publish_odom_tf" default="true"/>
  <arg name="odom_parent_frame" default="world"/>
  <arg name="odom_child_frame" default="$(arg robot_name)/base_link"/>
  <arg name="use_odom_frame" default="true"/>

  <arg name="lidar_topic" default="/cloud_registered_360"/>
  <arg name="planner_pointcloud_topic" default="/cloud_registered_fixed"/>
  <arg name="fix_pointcloud_frame" default="true"/>
  <arg name="fixed_lidar_topic" default="/cloud_registered_fixed"/>
  <arg name="lidar_frame_id" default="$(arg robot_name)/$(arg robot_name)/velodyne"/>
  <arg name="pointcloud_simple_mode" default="false"/>
  <!-- Keep virtual walls out of the real mapping point cloud by default.
       Voxblox ray-carves free space toward every point, so fake wall points can
       erase real side walls in TSDF/ESDF. Global z is enforced inside gbplanner
       path feasibility instead. -->
  <arg name="virtual_z_walls_enable" default="false"/>

  <arg name="gbplanner_config_file"
       default="$(find gbplanner)/config/$(arg robot_name)/gbplanner_config.yaml"/>
  <arg name="pci_file"
       default="$(find gbplanner)/config/$(arg robot_name)/planner_control_interface_real_config.yaml"/>
  <arg name="map_config_file"
       default="$(find gbplanner)/config/$(arg robot_name)/voxblox_sim_config.yaml"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="tf" type="static_transform_publisher" name="tf_world_to_navigation"
        args="0 0 0 0 0 0 world navigation 100"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_camera_init_to_world"
        args="0 0 0 0 0 0 world camera_init 100"/>

  <node if="$(arg publish_odom_tf)" pkg="gbplanner" type="odom_to_tf_node"
        name="odom_to_tf_node" output="screen">
    <param name="odom_topic" value="$(arg odometry_topic)"/>
    <param name="parent_frame" value="$(arg odom_parent_frame)"/>
    <param name="child_frame" value="$(arg odom_child_frame)"/>
    <param name="use_odom_frame" value="$(arg use_odom_frame)"/>
    <param name="publish_rate" value="200.0"/>
  </node>

  <node pkg="tf" type="static_transform_publisher" name="tf_vi_sensor"
        args="0.15 0 0.0 0.0 0.261 0.0 $(arg robot_name)/base_link $(arg robot_name)/vi_sensor/base_link 10"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_fcu"
        args="0 0 0 0 0 0 $(arg robot_name)/vi_sensor/base_link fcu 1"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_depth_camera"
        args="0.015 0.055 0.0065 -1.57 0.1 -1.57 fcu $(arg robot_name)/vi_sensor/camera_depth_optical_center_link 1"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_camera_left"
        args="0.015 0.055 0.0065 -1.57 0.1 -1.57 fcu $(arg robot_name)/vi_sensor/camera_left_link 1"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_camera_right"
        args="0.015 -0.055 0.0065 -1.57 0.1 -1.57 fcu $(arg robot_name)/vi_sensor/camera_right_link 1"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_velodyne"
        args="0 0 0.05 0.0 0.0 0.0 $(arg robot_name)/base_link $(arg robot_name)/$(arg robot_name)/velodyne 10"/>

  <node if="$(arg fix_pointcloud_frame)" pkg="gbplanner"
        type="pointcloud_real_robot_converter_node" name="pointcloud_real_robot_converter_node"
        output="screen">
    <param name="input_topic" value="$(arg lidar_topic)"/>
    <param name="output_topic" value="$(arg fixed_lidar_topic)"/>
    <param name="target_frame" value="$(arg lidar_frame_id)"/>
    <param name="simple_mode" value="$(arg pointcloud_simple_mode)"/>
    <param name="transform_timeout" value="0.1"/>
    <param name="fallback_to_frame_id_change" value="false"/>
    <param name="use_latest_transform_fallback" value="true"/>
    <param name="latest_transform_max_age_sec" value="0.05"/>
    <param name="virtual_z_walls_enable" value="$(arg virtual_z_walls_enable)"/>
    <param name="virtual_z_walls_bounds_param_ns" value="/gbplanner_node/BoundedSpaceParams/Global"/>
    <param name="virtual_z_walls_frame" value="world"/>
    <param name="virtual_z_walls_resolution" value="0.2"/>
    <param name="virtual_z_walls_forward_length" value="8.0"/>
    <param name="virtual_z_walls_backward_length" value="2.0"/>
    <param name="virtual_z_walls_use_global_xy" value="false"/>
    <param name="virtual_z_walls_add_min_z" value="true"/>
    <param name="virtual_z_walls_add_max_z" value="true"/>
  </node>

  <group ns="$(arg robot_name)">
    <node name="odo_throttler" type="throttle" pkg="topic_tools"
          args="messages $(arg odometry_topic) 100 ground_truth/odometry_throttled"/>
  </group>

  <node pkg="gbplanner" type="gbplanner_node" name="gbplanner_node"
        output="screen" launch-prefix="$(arg launch_prefix)">
    <remap from="odometry" to="$(arg planner_odometry_topic)"/>
    <remap from="/pointcloud" to="$(arg planner_pointcloud_topic)"/>
    <remap from="query_point" to="/rmf_obelix/tsdf_query_pt"/>
    <remap from="local_navigation_goal" to="/move_base_simple/goal"/>
    <rosparam command="load" file="$(arg gbplanner_config_file)"/>
    <rosparam command="load" file="$(arg map_config_file)"/>
    <param name="behavior_tree_path"
           value="$(find gbplanner)/config/bt_xml/main_tree.xml"/>
  </node>

  <node pkg="pci_general" type="pci_general_ros_node"
        name="pci_general_ros_node" output="screen">
    <remap from="command/trajectory" to="$(arg robot_name)/command/trajectory"/>
    <remap from="planner_server" to="gbplanner_ros"/>
    <remap from="planner_homing_server" to="gbplanner/homing"/>
    <remap from="odometry" to="$(arg planner_odometry_topic)"/>
    <rosparam command="load" file="$(arg pci_file)"/>
  </node>

  <node if="$(arg traj_server_en)" pkg="sim_tools" type="traj_server_node"
        name="traj_server_node" output="screen">
    <remap from="rmf_obelix/command/trajectory" to="$(arg robot_name)/command/trajectory"/>
    <remap from="/position_cmd" to="/position_cmd"/>
  </node>

  <node pkg="gbplanner_ui" type="gbplanner_topic_command_bridge"
        name="gbplanner_topic_command_bridge" output="screen"/>

  <node if="$(arg rviz_en)" pkg="rviz" type="rviz" name="gbplanner_ui"
        output="screen"
        args="-d $(find gbplanner)/config/rviz/rmf_obelix.rviz"/>
</launch>
