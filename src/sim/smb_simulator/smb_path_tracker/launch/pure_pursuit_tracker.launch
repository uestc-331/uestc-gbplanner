<launch>
	<arg name="use_action" default="false" />
	<arg name="path_topic" default="path" />
	<arg name="odometry_topic" default="/ground_truth/state" />
	<arg name="vel_topic" default="/smb_velocity_controller/cmd_vel" />
	<arg name="robot_frame" default="base_link" />
	<node name="smb_path_tracker_node" pkg="smb_path_tracker" type="smb_path_tracker_ros_node" output="screen">
		<remap from="cmd_vel" to="$(arg vel_topic)" />
		<remap from="odometry" to="$(arg odometry_topic)" />
		<remap from="path" to="$(arg path_topic)" />
		<param name="critical_angle" value="1.57"/>
		<param name="max_ang_vel" value="0.75"/>
		<param name="desired_vel" value="1.5"/>
		<param name="look_ahead_error_margin" value="0.2"/>
		<param name="look_ahead_distance" value="1.0"/>
		<param name="use_action" value="$(arg use_action)"/>
		<param name="robot_frame" value="$(arg robot_frame)"/>
	</node>
</launch>